{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "las-primas-club",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	// La web (React) se sirve como assets estáticos; /api/* lo atiende el Worker.
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	// Dominio propio (la zona rdvl.net debe estar en esta cuenta de Cloudflare).
	// Cloudflare crea el DNS y el certificado HTTPS automáticamente, gratis.
	"routes": [
		{ "pattern": "las-primas-club.rdvl.net", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "las-primas-club-d1",
			"database_id": "357d8360-03ad-47de-bbd4-bc107d146f4b",
			"migrations_dir": "migrations"
		}
	],
	// Archivos epub de los libros (gratis: 1 GB y hasta 25 MiB por archivo)
	"kv_namespaces": [
		{ "binding": "EPUBS", "id": "2a41f688b1a943e6a1ffde49e325baeb" }
	],
	"vars": {
		// Client ID público de Google OAuth (no es secreto).
		"GOOGLE_CLIENT_ID": "48926094831-jee1eqjs1p88r4dso557gmqbr4p7e2lc.apps.googleusercontent.com",
		// Remitente de los envíos al Kindle (dominio verificado en Resend). Cada miembro debe
		// añadir esta dirección a su lista de emails aprobados de Amazon.
		"KINDLE_FROM": "Las Primas Club <libros@las-primas-club.rdvl.net>"
	},
	// Secretos (configurar con `npx wrangler secret put NOMBRE`):
	//   ADMIN_EMAILS (opcional): admins de emergencia, siempre pueden entrar. Los miembros se gestionan en /admin.
	//   GOOGLE_BOOKS_API_KEY (opcional): clave gratuita de Google Books para buscar libros
	//   RESEND_API_KEY (opcional): clave de Resend (gratis, 100 emails/día) para "Enviar a mi Kindle"
	"observability": {
		"enabled": true
	}
}